#compdef ncd

__debug() {
  echo "$@" >> /tmp/ncd_debug
}

__ncd_caching_policy() {
  local -a oldp
  oldp=( "${1}"(Nmh+12) ) # 12 hours
  (( ${#oldp} ))
}

__ncd_arguments() {
  integer ret=1

  case "${words[1]}" in
    config)
      _message "Enter config key" && ret=0
      ;;
    ec2_ip)
      _message "Enter pattern for EC2 name" && ret=0
      ;;
    aws)
      local curcontext="${curcontext}" state

      _arguments -C \
        '1: :->scope' \
        '*:: :->args' \
        && ret=0

      case "${state}" in
        scope)
          _ncd_aws_scopes=()
          _ncd_aws_scopes+=("codeartifact-auth-token")
          _describe -t scope "scope" _ncd_aws_scopes \
            && ret=0
          ;;
        args)
          case "${words[1]}" in
          esac
          ;;
      esac
      ;;
    es)
      _ncd_es_commands=()
      _ncd_es_commands+=("aqs")
      _describe -t commands "commands" _ncd_es_commands \
        && ret=0
      ;;
    cmp)
      local curcontext="${curcontext}" state

      _arguments -C \
        '1: :->service' \
        '*: :->command' \
        && ret=0

      case "${state}" in
        service)
          _ncd_cmp_services=()
          _ncd_cmp_services+=("permissions")
          _describe -t services "services" _ncd_cmp_services \
            && ret=0
          ;;
        command)
          _message "Enter command for cmp ${words[2]}" && ret=0
          case "${words[$CURRENT]}" in
            *)
              case "${words[2]}" in
                permissions)
                  _ncd_cmp_permissions_commands=()
                  _ncd_cmp_permissions_commands+=("gremlin")
                  _describe -t commands "commands" _ncd_cmp_permissions_commands \
                    && ret=0
              esac
              ;;
          esac
          ;;
      esac
      ;;
    k8s)
      _ncd_k8s_commands=()
      _ncd_k8s_commands+=("add-context" "current-context")
      _ncd_k8s_commands+=("create-token" "copy-token")
      _ncd_k8s_commands+=("exec" "logs")
      _describe -t commands "commands" _ncd_k8s_commands \
        && ret=0
      ;;
    py)
      _ncd_py_commands=("venv-init" "venv-remove" "try-install")
      _describe -t commands "commands" _ncd_py_commands \
        && ret=0
      ;;
  esac

  return ret
}

__ncd_commands() {
  local -a _ncd_commands=()
  _ncd_commands+=("on" "off")
  _ncd_commands+=("py" "k8s")
  _ncd_commands+=("aws")
  _ncd_commands+=("es" "cmp")

  _describe -t ncd-commands "commands" _ncd_commands
}

_ncd() {
  setopt localoptions typesetsilent

  local context curcontext="${curcontext}" state state_descr line
  local -A opt_args
  integer ret=1

  _arguments -C \
    '1: :->command' \
    '*:: :->argument' \
    && ret=0

  case "${state}" in
    command)
      __ncd_commands && ret=0
      ;;
    argument)
      curcontext="${curcontext%:*}:${words[1]}:"
      __ncd_arguments && ret=0
      ;;
  esac

  return ret
}

_ncd $@
